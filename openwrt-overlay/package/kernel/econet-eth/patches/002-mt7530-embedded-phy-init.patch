 _Static_assert(sizeof(struct en751221_regs) == 0x10000, "en751221_regs size incorrect");
 
+/*
+ * Internal MDIO controller ("PHY_IAC" in MediaTek terms), used to reach
+ * the switch's embedded Gigabit PHYs directly -- separate from the
+ * MT753X_PMCR_P()/MT753X_MFC port-config registers above.
+ *
+ * Confirmed against the OEM eth.ko (Ghidra decompilation,
+ * tcMiiStationWrite()/tcMiiStationRead() @ eth.ko+0x1b800/+0x1b91c): both
+ * bit-bang this exact register at absolute VA 0xbfb5f01c, i.e. switch_regs
+ * offset 0x701c (0xbfb5f01c - 0xbfb58000).
+ */
+#define MT753X_PHY_IAC			0x701c
+#define  PHY_IAC_ACCESS			BIT(31)
+#define  PHY_IAC_REG_MASK		GENMASK(29, 25)
+#define  PHY_IAC_REG(x)			FIELD_PREP(PHY_IAC_REG_MASK, x)
+#define  PHY_IAC_ADDR_MASK		GENMASK(24, 20)
+#define  PHY_IAC_ADDR(x)		FIELD_PREP(PHY_IAC_ADDR_MASK, x)
+#define  PHY_IAC_CMD_MASK		GENMASK(19, 16)
+#define  PHY_IAC_CMD(x)			FIELD_PREP(PHY_IAC_CMD_MASK, x)
+#define  PHY_IAC_CMD_WRITE		0x05
+#define  PHY_IAC_CMD_READ		0x09
+#define  PHY_IAC_DATA_MASK		GENMASK(15, 0)
+
+/* MDIO address of the switch's built-in Gigabit PHYs, per the OEM's
+ * mdio_cl22_write(0xc, ...) calls in mt7530_switch_init(). */
+#define MT753X_EMBEDDED_PHY_ADDR	0xc
+
+static inline void __iomem *en75_swreg(struct en751221_regs __iomem *regs,
+					u32 off)
+{
+	return (void __iomem *)regs->switch_regs + off;
+}
+
+/* Poll PHY_IAC_ACCESS the same way the OEM driver does: up to 10000 tight
+ * spins, no delay between them. */
+static int en75_mdio_iac_wait(void __iomem *iac)
+{
+	int i = 10000;
+
+	while (--i >= 0 && (readl(iac) & PHY_IAC_ACCESS))
+		cpu_relax();
+
+	return i < 0 ? -ETIMEDOUT : 0;
+}
+
+static void en75_mdio_c22_write(struct en751221_regs __iomem *regs,
+				 u8 phy_addr, u8 reg, u16 val)
+{
+	void __iomem *iac = en75_swreg(regs, MT753X_PHY_IAC);
+
+	if (en75_mdio_iac_wait(iac))
+		return;
+
+	writel(PHY_IAC_ACCESS | PHY_IAC_CMD(PHY_IAC_CMD_WRITE) |
+	       PHY_IAC_REG(reg) | PHY_IAC_ADDR(phy_addr) | val, iac);
+
+	en75_mdio_iac_wait(iac);
+}
+
+static u16 en75_mdio_c22_read(struct en751221_regs __iomem *regs,
+			       u8 phy_addr, u8 reg)
+{
+	void __iomem *iac = en75_swreg(regs, MT753X_PHY_IAC);
+
+	if (en75_mdio_iac_wait(iac))
+		return 0xffff;
+
+	writel(PHY_IAC_ACCESS | PHY_IAC_CMD(PHY_IAC_CMD_READ) |
+	       PHY_IAC_REG(reg) | PHY_IAC_ADDR(phy_addr), iac);
+
+	if (en75_mdio_iac_wait(iac))
+		return 0xffff;
+
+	return readl(iac) & PHY_IAC_DATA_MASK;
+}
+
+/*
+ * Clause-45-over-clause-22 "indirect" MMD access (IEEE 802.3 Annex 22D):
+ * MII_MMD_CTRL (0xd) selects the MMD + address/data mode, MII_MMD_DATA
+ * (0xe) carries the address or the data word. This is bit-for-bit what
+ * the OEM's mdio_cl22_write() does (eth.ko+0x1bb08), confirmed via
+ * Ghidra: it was originally 5 calls to tcMiiStationWrite() that gcc
+ * inlined into one function.
+ */
+static void en75_mdio_mmd_write(struct en751221_regs __iomem *regs,
+				 u8 phy_addr, u8 devad, u16 mmd_reg, u16 val)
+{
+	en75_mdio_c22_write(regs, phy_addr, MII_MMD_CTRL, 0);
+	en75_mdio_c22_write(regs, phy_addr, MII_MMD_CTRL, devad);
+	en75_mdio_c22_write(regs, phy_addr, MII_MMD_DATA, mmd_reg);
+	en75_mdio_c22_write(regs, phy_addr, MII_MMD_CTRL,
+			     devad | MII_MMD_CTRL_NOINCR);
+	en75_mdio_c22_write(regs, phy_addr, MII_MMD_DATA, val);
+}
+
+/*
+ * Bring-up sequence for the switch's embedded Gigabit PHYs, ported from
+ * the OEM eth.ko's mt7530_switch_init() (Ghidra offset eth.ko+0x1a974,
+ * the "!use_ext_switch" branch -- this SoC's switch and PHYs are on-die,
+ * not a discrete external MT7530 reached over a real MDIO wire).
+ *
+ * Without this sequence the embedded PHYs never autonegotiate: MAC-side
+ * registers (PMCR/MFC, already configured above in en75_probe()) can be
+ * perfectly correct while the PHY itself stays dead -- this was blocking
+ * gmac1/ETHWAN link-up (registers fine, no PHY link). Fixed and verified
+ * on real VMG8825-T50 hardware: link up, autoneg complete, real traffic
+ * received on eth1 with a cable plugged into ETHWAN.
+ *
+ * Register 0x404's value (0x1900 vs 0x1d00 in the OEM binary) depends on
+ * board-strap reads at absolute VA 0xbfb00064 / 0xbfb000f8 / 0xbfbf8214,
+ * none of which are inside this driver's ethernet@ register window (they
+ * live in the SoC's SCU/GPIO-strap blocks) and 0xbfbf8214 in particular
+ * isn't mapped by any DT node we have. 0x1900 is confirmed correct for
+ * the Zyxel VMG8825-T50 by live hardware test (link up, autoneg complete,
+ * real traffic received on gmac1/ETHWAN with a cable plugged in) -- the
+ * other OEM branch (0x1d00) left the PHY registers readable but with no
+ * link at all. A different board sharing this SoC may need 0x1d00 instead
+ * if it hits the OEM's other strap-detection branch.
+ *
+ * Also deliberately NOT ported: a ~4096-iteration loop the OEM does just
+ * before this (writing an incrementing index to switch_regs offset 0x90
+ * with a fixed 0x607f0001 companion write to offset 0x94) -- that shape
+ * matches a bulk ARL/L2-table or MIB-counter clear, not PHY bring-up,
+ * and isn't worth the risk of replaying blind on real hardware.
+ */
+static void en75_mt7530_embedded_phy_init(struct en751221_regs __iomem *regs)
+{
+	static const struct { u16 reg, val; } cal_seq[] = {
+		{ 0x103, 0x0020 },
+		{ 0x104, 0x2608 },
+		{ 0x404, 0x1900 }, /* confirmed on HW, see comment above */
+		{ 0x409, 0x0057 },
+		{ 0x40a, 0x0057 },
+		{ 0x403, 0x1800 },
+		{ 0x403, 0x1c00 },
+		{ 0x401, 0xc020 },
+		{ 0x406, 0xa030 },
+		{ 0x410, 0x0003 },
+	};
+	int i;
+
+	writel(0x3f27, en75_swreg(regs, 0x30e0));
+
+	for (i = 0; i < ARRAY_SIZE(cal_seq); i++)
+		en75_mdio_mmd_write(regs, MT753X_EMBEDDED_PHY_ADDR,
+				    MDIO_MMD_VEND2, cal_seq[i].reg,
+				    cal_seq[i].val);
+
+	/* Per-port analog/queue config that follows the PHY calibration in
+	 * the OEM sequence -- plain MMIO, all inside switch_regs.
+	 *
+	 * IMPORTANT: the OEM sequence writes these to ALL 5-7 ports in a
+	 * loop (offsets 0x7a10/0x7a18/.../0x7a30 and 0x201c/0x211c/.../
+	 * 0x261c, one entry per port 0-4 or 0-6). We only want the WAN
+	 * port (switch port 4)'s entries -- writing the others clobbered
+	 * the LAN ports' own per-port VLAN config and broke LAN forwarding
+	 * on real hardware (regression found and fixed same day). Port 4
+	 * is the 5th entry in the 0x7a10-stride-8 group (-> 0x7a30) and
+	 * the 5th entry in the 0x201c-stride-0x100 group (-> 0x241c). The
+	 * CPU port's own PVC write (0xa610/0x2610 in the OEM sequence) is
+	 * dropped entirely: it duplicates what our own en75_probe() already
+	 * configures for the CPU port via EN75_MFC_CONFIG/PMCR, and touching
+	 * it a second time here is what broke LAN. */
+	writel(1, en75_swreg(regs, 0x7a30));
+	writel(0x4a010101, en75_swreg(regs, 0x241c));
+	writel(0x1017e8f, en75_swreg(regs, 0x7804));
+	writel(1, en75_swreg(regs, 0x7808));
+	writel(1, en75_swreg(regs, 0x7830));
+	writel(0x80083020, en75_swreg(regs, 0x1fe0));
+
+	/*
+	 * NOT part of the OEM sequence -- found separately after the PHY
+	 * fix above still showed zero RX traffic on eth1 despite a solid
+	 * PHY link (confirmed via qdma1 debugfs: TX DONE count non-zero,
+	 * RX DONE count stuck at 0). Cross-checked against upstream Linux
+	 * drivers/net/dsa/mt7530.c's mt7530_port_enable(): a port's PCR
+	 * "matrix" (forwarding mask) must include the CPU port's bit or
+	 * ingress frames are dropped instead of forwarded to the CPU/GDM
+	 * queue. WAN (switch port 4) never got this -- only ports touched
+	 * by en75_probe() (5 and 6, via PMCR) did, and PMCR/PCR are
+	 * different registers (0x3000 vs 0x2004 + n*0x100). Set port 4's
+	 * PCR_MATRIX to CPU-port-only (bit 6, matching our own CPU port
+	 * index from EN75_MFC_CONFIG's MT7530_CPU_PORT(6)/PMCR_P(6)).
+	 */
+	writel(BIT(6) << 16, en75_swreg(regs, 0x2404));
+}
+
