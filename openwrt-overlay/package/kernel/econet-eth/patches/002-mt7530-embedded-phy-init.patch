 		en75_wreg(EN75_PMCR_CONFIG, &regs->switch_regs[MT753X_PMCR_P(6) / 4]);
 		en75_wreg(EN75_MFC_CONFIG, &regs->switch_regs[MT753X_MFC / 4]);
+		en75_mt7530_embedded_phy_init(regs);
+		/* debugfs: /sys/kernel/debug/wan_phy_status, on-demand (not
+		 * probe-time -- autoneg needs real time to settle) read of
+		 * the WAN port's embedded PHY (addr 0xc) clause-22 status. */
+		debugfs_create_file("wan_phy_status", 0444, NULL, regs,
+				     &en75_wan_phy_status_fops);
 	}
 
 	return 0;
