+/* Diagnostic debugfs file: on-demand clause-22 status of the WAN port's
+ * embedded PHY (addr 0xc). BMSR's link-status bit is latch-low, so it's
+ * read twice: first clears a stale latched-down, second reflects the
+ * live state. Kept permanently (used to verify the fix in
+ * en75_mt7530_embedded_phy_init() above on real hardware; harmless and
+ * useful for future WAN-link debugging). */
+static int en75_wan_phy_status_show(struct seq_file *m, void *v)
+{
+	struct en751221_regs __iomem *regs = m->private;
+
+	en75_mdio_c22_read(regs, MT753X_EMBEDDED_PHY_ADDR, MII_BMSR);
+	seq_printf(m, "BMCR=0x%04x BMSR=0x%04x ANLPAR=0x%04x\n",
+		   en75_mdio_c22_read(regs, MT753X_EMBEDDED_PHY_ADDR, MII_BMCR),
+		   en75_mdio_c22_read(regs, MT753X_EMBEDDED_PHY_ADDR, MII_BMSR),
+		   en75_mdio_c22_read(regs, MT753X_EMBEDDED_PHY_ADDR, MII_LPA));
+	return 0;
+}
+
+static int en75_wan_phy_status_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, en75_wan_phy_status_show, inode->i_private);
+}
+
+static const struct file_operations en75_wan_phy_status_fops = {
+	.owner = THIS_MODULE,
+	.open = en75_wan_phy_status_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
