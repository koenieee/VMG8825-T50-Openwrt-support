+/*
+ * Set the etx descriptor's IP/TCP/UDP checksum-offload bits for skb, or
+ * finish the checksum in software if the combination of protocols in skb
+ * isn't something the descriptor can express (SCTP, IPv6 extension headers
+ * before L4, etc). No-op if the stack already computed the checksum itself
+ * (skb->ip_summed != CHECKSUM_PARTIAL).
+ *
+ * ETX_ICO is only meaningful alongside ETX_TCO/ETX_UCO (it tells hardware
+ * to use the IPv4 pseudo-header when computing the L4 checksum, it isn't a
+ * standalone "also write the IPv4 header checksum" feature -- the stack
+ * always computes that one itself regardless of CHECKSUM_PARTIAL), so it's
+ * only set together with one of them, never alone.
+ */
+static void en75_dev_xmit_csum(struct sk_buff *skb, struct etx *etx)
+{
+	bool is_ipv4;
+	u8 l4_proto;
+
+	if (skb->ip_summed != CHECKSUM_PARTIAL)
+		return;
+
+	switch (skb->protocol) {
+	case htons(ETH_P_IP):
+		is_ipv4 = true;
+		l4_proto = ip_hdr(skb)->protocol;
+		break;
+	case htons(ETH_P_IPV6):
+		is_ipv4 = false;
+		l4_proto = ipv6_hdr(skb)->nexthdr;
+		break;
+	default:
+		skb_checksum_help(skb);
+		return;
+	}
+
+	switch (l4_proto) {
+	case IPPROTO_TCP:
+		set_etx_tco(etx, true);
+		break;
+	case IPPROTO_UDP:
+		set_etx_uco(etx, true);
+		break;
+	default:
+		skb_checksum_help(skb);
+		return;
+	}
+
+	if (is_ipv4)
+		set_etx_ico(etx, true);
+}
+
 static netdev_tx_t en75_dev_xmit(struct sk_buff *skb, struct net_device *dev)
 {
 	struct en75_gdm_port *port = netdev_priv(dev);
@@ -205,6 +258,8 @@
