+#define PPE_TB_CFG_AGE_TCP_FIN		BIT(11)
+#define PPE_TB_CFG_KEEPALIVE		GENMASK(13, 12)
+#define PPE_TB_CFG_HASH_MODE		GENMASK(15, 14)
