+/*
+ * Single FOE table for the SoC's single PPE instance. Kept file-static
+ * rather than in struct en75_eth because there is exactly one of each and
+ * econet_port.c needs to know whether it came up.
+ */
+static void *en75_foe_table;
+static dma_addr_t en75_foe_phys;
+
 static u32 en75_ppe_rd(struct en751221_regs __iomem *regs, u32 off)
 {
 	return ioread32(&regs->ppe[off / sizeof(u32)]);
 }
 
+static void en75_ppe_wr(struct en751221_regs __iomem *regs, u32 off, u32 val)
+{
+	iowrite32(val, &regs->ppe[off / sizeof(u32)]);
+}
