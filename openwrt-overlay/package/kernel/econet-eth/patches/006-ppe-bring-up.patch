+/*
+ * FOE table geometry. PPE_TB_CFG_ENTRY_NUM is log2 of the entry count in
+ * units of 1024, so shift 0 is the smallest legal table. Upstream uses
+ * shift 4 (16384 entries), but a 1024-entry table is 80 KiB of coherent
+ * DMA instead of 1.25 MiB, which is the right trade on a 128 MiB router
+ * while the binding path is still being brought up.
+ *
+ * 80-byte entries: PPE_TB_CFG_ENTRY_80B is set for everything before
+ * MediaTek's netsys v3, and the OEM's hw_nat v2.01 uses the same size.
+ */
+#define EN75_PPE_ENTRIES_SHIFT		0
+#define EN75_PPE_ENTRIES		(1024 << EN75_PPE_ENTRIES_SHIFT)
+#define EN75_PPE_ENTRY_SIZE		80
