+/*
+ * Bring up the PPE: give it a zeroed FOE table, tell it how to age and
+ * bind flows, and enable it.
+ *
+ * This is a trimmed transcription of mtk_ppe_start() from upstream's
+ * drivers/net/ethernet/mediatek/mtk_ppe.c -- the register block is the
+ * same IP, so the programming sequence is too. Left out for now are the
+ * accounting/MIB table and the netsys-v2+ paths, neither of which applies
+ * here.
+ *
+ * Nothing binds flows yet, so with this alone every packet still takes the
+ * search-miss path to the CPU. What it buys is the RX descriptor's
+ * ppe_entry field becoming meaningful, which is the prerequisite for the
+ * binding logic and can be checked in /sys/kernel/debug/ppe_regs.
+ */
+static int en75_ppe_start(struct device *dev, struct en751221_regs __iomem *regs)
+{
+	u32 val;
+
+	en75_foe_table = dmam_alloc_coherent(dev,
+					     EN75_PPE_ENTRIES * EN75_PPE_ENTRY_SIZE,
+					     &en75_foe_phys, GFP_KERNEL);
+	if (!en75_foe_table)
+		return -ENOMEM;
+
+	en75_ppe_wr(regs, PPE_TB_BASE, en75_foe_phys);
+
+	val = PPE_TB_CFG_AGE_NON_L4 |
+	      PPE_TB_CFG_AGE_UNBIND |
+	      PPE_TB_CFG_AGE_TCP |
+	      PPE_TB_CFG_AGE_UDP |
+	      PPE_TB_CFG_AGE_TCP_FIN |
+	      PPE_TB_CFG_ENTRY_80B |
+	      FIELD_PREP(PPE_TB_CFG_SEARCH_MISS, PPE_SEARCH_MISS_FORWARD_BUILD) |
+	      FIELD_PREP(PPE_TB_CFG_KEEPALIVE, PPE_KEEPALIVE_DISABLE) |
+	      FIELD_PREP(PPE_TB_CFG_HASH_MODE, 1) |
+	      FIELD_PREP(PPE_TB_CFG_SCAN_MODE, PPE_SCAN_MODE_CHECK_AGE) |
+	      FIELD_PREP(PPE_TB_CFG_ENTRY_NUM, EN75_PPE_ENTRIES_SHIFT);
+	en75_ppe_wr(regs, PPE_TB_CFG, val);
+
+	en75_ppe_wr(regs, PPE_IP_PROT_CHK,
+		    PPE_IP_PROT_CHK_IPV4 | PPE_IP_PROT_CHK_IPV6);
+
+	en75_ppe_wr(regs, PPE_CAH_CTRL, PPE_CAH_CTRL_X_MODE);
+	en75_ppe_wr(regs, PPE_CAH_CTRL, 0);
+	en75_ppe_wr(regs, PPE_CAH_CTRL, PPE_CAH_CTRL_EN);
+
+	en75_ppe_wr(regs, PPE_FLOW_CFG,
+		    PPE_FLOW_CFG_IP6_3T_ROUTE | PPE_FLOW_CFG_IP6_5T_ROUTE |
+		    PPE_FLOW_CFG_IP6_6RD | PPE_FLOW_CFG_IP4_NAT |
+		    PPE_FLOW_CFG_IP4_NAPT | PPE_FLOW_CFG_IP4_DSLITE |
+		    PPE_FLOW_CFG_IP4_NAT_FRAG | PPE_FLOW_CFG_IP4_TCP_FRAG |
+		    PPE_FLOW_CFG_IP4_UDP_FRAG);
+
+	en75_ppe_wr(regs, PPE_UNB_AGE,
+		    FIELD_PREP(PPE_UNB_AGE_MIN_PACKETS, 1000) |
+		    FIELD_PREP(PPE_UNB_AGE_DELTA, 3));
+	en75_ppe_wr(regs, PPE_BND_AGE_0,
+		    FIELD_PREP(PPE_BND_AGE_0_DELTA_UDP, 12) |
+		    FIELD_PREP(PPE_BND_AGE_0_DELTA_NON_L4, 1));
+	en75_ppe_wr(regs, PPE_BND_AGE_1,
+		    FIELD_PREP(PPE_BND_AGE_1_DELTA_TCP_FIN, 1) |
+		    FIELD_PREP(PPE_BND_AGE_1_DELTA_TCP, 7));
+	en75_ppe_wr(regs, PPE_BIND_LMT_0,
+		    PPE_BIND_LMT_0_QUARTER | PPE_BIND_LMT_0_HALF);
+	en75_ppe_wr(regs, PPE_BIND_LMT_1,
+		    PPE_BIND_LMT_1_FULL | FIELD_PREP(PPE_BIND_LMT_1_NON_L4, 1));
+	en75_ppe_wr(regs, PPE_BNDR,
+		    FIELD_PREP(PPE_BNDR_BIND, 30) |
+		    FIELD_PREP(PPE_BNDR_PREBIND, 1));
+
+	en75_ppe_wr(regs, PPE_GLO_CFG,
+		    PPE_GLO_CFG_EN | PPE_GLO_CFG_IP4_L4_CS_DROP |
+		    PPE_GLO_CFG_IP4_CS_DROP | PPE_GLO_CFG_FLOW_DROP_UPDATE);
+
+	en75_ppe_wr(regs, PPE_DFP_CPORT, 0);
+
+	dev_info(dev, "PPE up: %d FOE entries at %pad\n",
+		 EN75_PPE_ENTRIES, &en75_foe_phys);
+	en75_ppe_running = true;
+	return 0;
+}
