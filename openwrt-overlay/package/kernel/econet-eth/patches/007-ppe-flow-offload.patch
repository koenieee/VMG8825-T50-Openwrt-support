+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * PPE (Packet Processing Engine) hardware flow offload for EN751627.
+ *
+ * Ported from upstream Linux's MediaTek PPE driver, mtk_ppe.c and
+ * mtk_ppe_offload.c, Copyright (C) 2020 Felix Fietkau <nbd@nbd.name>.
+ * See econet_ppe.h for why that is a port rather than a rewrite.
+ *
+ * How a flow gets bound, end to end:
+ *
+ *  1. nftables' flowtable (or `tc` directly) hands us an established
+ *     conntrack flow via ndo_setup_tc -> en75_ppe_setup_tc. We translate
+ *     its match keys and mangle actions into an FOE entry and park it in
+ *     a software list, bucketed by the same hash the hardware uses.
+ *  2. Meanwhile the engine has been counting packets of that flow against
+ *     an UNBIND entry of its own. When the count crosses PPE_BNDR's
+ *     threshold it stamps HIT_UNBIND_RATE_REACHED into the RX descriptor.
+ *  3. en75_ppe_check_skb() sees that, matches the packet against our
+ *     parked entries, and writes the real BIND entry into the table.
+ *  4. From then on the hardware forwards that flow itself. Linux never
+ *     sees another packet of it -- which is the entire point.
+ */
+
+#include <linux/dma-mapping.h>
+#include <linux/etherdevice.h>
+#include <linux/if_vlan.h>
+#include <linux/ip.h>
+#include <linux/ipv6.h>
+#include <linux/rhashtable.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <net/dsa.h>
+#include <net/flow_offload.h>
+#include <net/ipv6.h>
+#include <net/pkt_cls.h>
+
+#include "econet_eth.h"
+#include "econet_ppe.h"
+
+struct en75_flow_entry {
+	struct rhash_head	node;
+	unsigned long		cookie;
+	struct hlist_node	list;
+	struct en75_foe_entry	data;
+	/* 0xffff until the hardware has actually bound this flow. */
+	u16			hash;
+};
+
+struct en75_ppe {
+	struct device		*dev;
+	void __iomem		*base;
+	void __iomem		*fe_base;
+	struct en75_foe_entry	*foe_table;
+
+	struct rhashtable	flow_table;
+	bool			flow_table_ready;
+
+	struct hlist_head	foe_flow[EN75_PPE_ENTRIES / EN75_PPE_HASH_OFFSET];
+};
+
+/*
+ * One lock for the whole engine. Taken in softirq context from the RX
+ * path, so every other holder has to use the _bh variants.
+ */
+static DEFINE_SPINLOCK(en75_ppe_lock);
+static DEFINE_MUTEX(en75_ppe_mutex);
+
+static const struct rhashtable_params en75_flow_ht_params = {
+	.head_offset = offsetof(struct en75_flow_entry, node),
+	.key_offset = offsetof(struct en75_flow_entry, cookie),
+	.key_len = sizeof(unsigned long),
+	.automatic_shrinking = true,
+};
+
+static u32 ppe_r32(struct en75_ppe *ppe, u32 reg)
+{
+	return ioread32(ppe->base + reg);
+}
+
+static void ppe_w32(struct en75_ppe *ppe, u32 reg, u32 val)
+{
+	iowrite32(val, ppe->base + reg);
+}
+
+static void ppe_m32(struct en75_ppe *ppe, u32 reg, u32 mask, u32 set)
+{
+	u32 val = ppe_r32(ppe, reg);
+
+	val &= ~mask;
+	val |= set;
+	ppe_w32(ppe, reg, val);
+}
+
+/*
+ * Free-running counter the engine stamps into bound entries and compares
+ * against for aging. Software has to seed new entries from the same
+ * counter or they age out immediately.
+ */
+static u32 en75_ppe_timestamp(struct en75_ppe *ppe)
+{
+	return ioread32(ppe->fe_base + 0x0010) & EN75_FOE_IB1_BIND_TIMESTAMP;
+}
+
+static struct en75_foe_entry *en75_foe_get_entry(struct en75_ppe *ppe, u16 hash)
+{
+	return &ppe->foe_table[hash];
+}
+
+/*
+ * The engine keeps a lookup cache in front of the FOE table. Editing an
+ * entry without flushing it leaves the old forwarding decision in force.
+ */
+static void en75_ppe_cache_clear(struct en75_ppe *ppe)
+{
+	ppe_m32(ppe, PPE_CAH_CTRL, 0, PPE_CAH_CTRL_X_MODE);
+	ppe_m32(ppe, PPE_CAH_CTRL, PPE_CAH_CTRL_X_MODE, 0);
+}
+
+/*
+ * Reimplementation of the hardware's own bucket hash. Software has to
+ * agree with it exactly: an entry written to the wrong index is simply
+ * never found by a lookup.
+ */
+static u32 en75_ppe_hash_entry(struct en75_foe_entry *e)
+{
+	u32 hv1, hv2, hv3;
+	u32 hash;
+
+	switch (FIELD_GET(EN75_FOE_IB1_PACKET_TYPE, e->ib1)) {
+	case EN75_PPE_PKT_TYPE_IPV4_ROUTE:
+	case EN75_PPE_PKT_TYPE_IPV4_HNAPT:
+		hv1 = e->ipv4.orig.ports;
+		hv2 = e->ipv4.orig.dest_ip;
+		hv3 = e->ipv4.orig.src_ip;
+		break;
+	case EN75_PPE_PKT_TYPE_IPV6_ROUTE_3T:
+	case EN75_PPE_PKT_TYPE_IPV6_ROUTE_5T:
+		hv1 = e->ipv6.src_ip[3] ^ e->ipv6.dest_ip[3];
+		hv1 ^= e->ipv6.ports;
+
+		hv2 = e->ipv6.src_ip[2] ^ e->ipv6.dest_ip[2];
+		hv2 ^= e->ipv6.dest_ip[0];
+
+		hv3 = e->ipv6.src_ip[1] ^ e->ipv6.dest_ip[1];
+		hv3 ^= e->ipv6.src_ip[0];
+		break;
+	default:
+		WARN_ON_ONCE(1);
+		return EN75_PPE_HASH_MASK;
+	}
+
+	hash = (hv1 & hv2) | ((~hv1) & hv3);
+	hash = (hash >> 24) | ((hash & 0xffffff) << 8);
+	hash ^= hv1 ^ hv2 ^ hv3;
+	hash ^= hash >> 16;
+	hash <<= (ffs(EN75_PPE_HASH_OFFSET) - 1);
+	hash &= EN75_PPE_ENTRIES - 1;
+
+	return hash;
+}
+
+static struct en75_foe_mac_info *en75_foe_entry_l2(struct en75_foe_entry *entry)
+{
+	int type = FIELD_GET(EN75_FOE_IB1_PACKET_TYPE, entry->ib1);
+
+	if (type >= EN75_PPE_PKT_TYPE_IPV4_DSLITE)
+		return &entry->ipv6.l2;
+
+	return &entry->ipv4.l2;
+}
+
+static u32 *en75_foe_entry_ib2(struct en75_foe_entry *entry)
+{
+	int type = FIELD_GET(EN75_FOE_IB1_PACKET_TYPE, entry->ib1);
+
+	if (type >= EN75_PPE_PKT_TYPE_IPV4_DSLITE)
+		return &entry->ipv6.ib2;
+
+	return &entry->ipv4.ib2;
+}
+
+static int en75_foe_entry_prepare(struct en75_foe_entry *entry, int type,
+				  int l4proto, u8 pse_port, const u8 *src_mac,
+				  const u8 *dest_mac)
+{
+	struct en75_foe_mac_info *l2;
+	u32 ports_pad, val;
+
+	memset(entry, 0, sizeof(*entry));
+
+	entry->ib1 = FIELD_PREP(EN75_FOE_IB1_STATE, EN75_FOE_STATE_BIND) |
+		     FIELD_PREP(EN75_FOE_IB1_PACKET_TYPE, type) |
+		     FIELD_PREP(EN75_FOE_IB1_UDP, l4proto == IPPROTO_UDP) |
+		     EN75_FOE_IB1_BIND_CACHE | EN75_FOE_IB1_BIND_TTL;
+
+	val = FIELD_PREP(EN75_FOE_IB2_DEST_PORT, pse_port) |
+	      FIELD_PREP(EN75_FOE_IB2_PORT_MG, 0x3f) |
+	      FIELD_PREP(EN75_FOE_IB2_PORT_AG, 0x1f);
+
+	if (is_multicast_ether_addr(dest_mac))
+		val |= EN75_FOE_IB2_MULTICAST;
+
+	/* The engine expects this exact filler in the unused port words. */
+	ports_pad = 0xa5a5a500 | (l4proto & 0xff);
+	if (type == EN75_PPE_PKT_TYPE_IPV4_ROUTE)
+		entry->ipv4.orig.ports = ports_pad;
+	if (type == EN75_PPE_PKT_TYPE_IPV6_ROUTE_3T)
+		entry->ipv6.ports = ports_pad;
+
+	if (type >= EN75_PPE_PKT_TYPE_IPV4_DSLITE) {
+		entry->ipv6.ib2 = val;
+		l2 = &entry->ipv6.l2;
+	} else {
+		entry->ipv4.ib2 = val;
+		l2 = &entry->ipv4.l2;
+	}
+
+	l2->dest_mac_hi = get_unaligned_be32(dest_mac);
+	l2->dest_mac_lo = get_unaligned_be16(dest_mac + 4);
+	l2->src_mac_hi = get_unaligned_be32(src_mac);
+	l2->src_mac_lo = get_unaligned_be16(src_mac + 4);
+
+	if (type >= EN75_PPE_PKT_TYPE_IPV6_ROUTE_3T)
+		l2->etype = ETH_P_IPV6;
+	else
+		l2->etype = ETH_P_IP;
+
+	return 0;
+}
+
+static void en75_foe_entry_set_pse_port(struct en75_foe_entry *entry, u8 port)
+{
+	u32 *ib2 = en75_foe_entry_ib2(entry);
+
+	*ib2 &= ~EN75_FOE_IB2_DEST_PORT;
+	*ib2 |= FIELD_PREP(EN75_FOE_IB2_DEST_PORT, port);
+}
+
+static int en75_foe_entry_set_ipv4_tuple(struct en75_foe_entry *entry,
+					 bool egress, __be32 src_addr,
+					 __be16 src_port, __be32 dest_addr,
+					 __be16 dest_port)
+{
+	int type = FIELD_GET(EN75_FOE_IB1_PACKET_TYPE, entry->ib1);
+	struct en75_ipv4_tuple *t;
+
+	switch (type) {
+	case EN75_PPE_PKT_TYPE_IPV4_HNAPT:
+		if (egress) {
+			t = &entry->ipv4.new;
+			break;
+		}
+		fallthrough;
+	case EN75_PPE_PKT_TYPE_IPV4_ROUTE:
+		t = &entry->ipv4.orig;
+		break;
+	default:
+		WARN_ON_ONCE(1);
+		return -EINVAL;
+	}
+
+	t->src_ip = be32_to_cpu(src_addr);
+	t->dest_ip = be32_to_cpu(dest_addr);
+
+	if (type == EN75_PPE_PKT_TYPE_IPV4_ROUTE)
+		return 0;
+
+	t->src_port = be16_to_cpu(src_port);
+	t->dest_port = be16_to_cpu(dest_port);
+
+	return 0;
+}
+
+static int en75_foe_entry_set_ipv6_tuple(struct en75_foe_entry *entry,
+					 __be32 *src_addr, __be16 src_port,
+					 __be32 *dest_addr, __be16 dest_port)
+{
+	int type = FIELD_GET(EN75_FOE_IB1_PACKET_TYPE, entry->ib1);
+	int i;
+
+	if (type != EN75_PPE_PKT_TYPE_IPV6_ROUTE_5T &&
+	    type != EN75_PPE_PKT_TYPE_IPV6_ROUTE_3T) {
+		WARN_ON_ONCE(1);
+		return -EINVAL;
+	}
+
+	if (type == EN75_PPE_PKT_TYPE_IPV6_ROUTE_5T) {
+		entry->ipv6.src_port = be16_to_cpu(src_port);
+		entry->ipv6.dest_port = be16_to_cpu(dest_port);
+	}
+
+	for (i = 0; i < 4; i++) {
+		entry->ipv6.src_ip[i] = be32_to_cpu(src_addr[i]);
+		entry->ipv6.dest_ip[i] = be32_to_cpu(dest_addr[i]);
+	}
+
+	return 0;
+}
+
+/*
+ * Egress out of a DSA user port. The switch tag is not a real VLAN: the
+ * engine is told to emit one "VLAN layer" whose etype word carries the
+ * destination port bitmap, which tag_mtk on the switch side consumes.
+ */
+static void en75_foe_entry_set_dsa(struct en75_foe_entry *entry, int port)
+{
+	struct en75_foe_mac_info *l2 = en75_foe_entry_l2(entry);
+
+	l2->etype = BIT(port);
+
+	if (!(entry->ib1 & EN75_FOE_IB1_BIND_VLAN_LAYER))
+		entry->ib1 |= FIELD_PREP(EN75_FOE_IB1_BIND_VLAN_LAYER, 1);
+	else
+		l2->etype |= BIT(8);
+
+	entry->ib1 &= ~EN75_FOE_IB1_BIND_VLAN_TAG;
+}
+
+static int en75_foe_entry_set_vlan(struct en75_foe_entry *entry, int vid)
+{
+	struct en75_foe_mac_info *l2 = en75_foe_entry_l2(entry);
+
+	switch (FIELD_GET(EN75_FOE_IB1_BIND_VLAN_LAYER, entry->ib1)) {
+	case 0:
+		entry->ib1 |= EN75_FOE_IB1_BIND_VLAN_TAG |
+			      FIELD_PREP(EN75_FOE_IB1_BIND_VLAN_LAYER, 1);
+		l2->vlan1 = vid;
+		return 0;
+	case 1:
+		if (!(entry->ib1 & EN75_FOE_IB1_BIND_VLAN_TAG)) {
+			l2->vlan1 = vid;
+			l2->etype |= BIT(8);
+		} else {
+			l2->vlan2 = vid;
+			entry->ib1 += FIELD_PREP(EN75_FOE_IB1_BIND_VLAN_LAYER, 1);
+		}
+		return 0;
+	default:
+		return -ENOSPC;
+	}
+}
+
+static int en75_foe_entry_set_pppoe(struct en75_foe_entry *entry, int sid)
+{
+	struct en75_foe_mac_info *l2 = en75_foe_entry_l2(entry);
+
+	if (!(entry->ib1 & EN75_FOE_IB1_BIND_VLAN_LAYER) ||
+	    (entry->ib1 & EN75_FOE_IB1_BIND_VLAN_TAG))
+		l2->etype = ETH_P_PPP_SES;
+
+	entry->ib1 |= EN75_FOE_IB1_BIND_PPPOE;
+	l2->pppoe_id = sid;
+
+	return 0;
+}
+
+/*
+ * How much of an entry is lookup key rather than result. Only this prefix
+ * is compared when deciding whether a packet belongs to a parked flow.
+ */
+static int en75_flow_entry_match_len(struct en75_foe_entry *entry)
+{
+	int type = FIELD_GET(EN75_FOE_IB1_PACKET_TYPE, entry->ib1);
+
+	if (type > EN75_PPE_PKT_TYPE_IPV4_DSLITE)
+		return offsetof(struct en75_foe_entry, ipv6._rsv);
+
+	return offsetof(struct en75_foe_entry, ipv4.ib2);
+}
+
+static bool en75_flow_entry_match(struct en75_flow_entry *entry,
+				  struct en75_foe_entry *data, int len)
+{
+	if ((data->ib1 ^ entry->data.ib1) & EN75_FOE_IB1_UDP)
+		return false;
+
+	if (FIELD_GET(EN75_FOE_IB1_PACKET_TYPE, data->ib1) !=
+	    FIELD_GET(EN75_FOE_IB1_PACKET_TYPE, entry->data.ib1))
+		return false;
+
+	return !memcmp(&entry->data.data, &data->data, len - sizeof(data->ib1));
+}
+
+/* Caller holds en75_ppe_lock. */
+static void __en75_foe_entry_clear(struct en75_ppe *ppe,
+				   struct en75_flow_entry *entry)
+{
+	struct en75_foe_entry *hwe;
+
+	if (entry->hash == 0xffff)
+		return;
+
+	hwe = en75_foe_get_entry(ppe, entry->hash);
+	hwe->ib1 &= ~EN75_FOE_IB1_STATE;
+	hwe->ib1 |= FIELD_PREP(EN75_FOE_IB1_STATE, EN75_FOE_STATE_INVALID);
+	dma_wmb();
+	en75_ppe_cache_clear(ppe);
+
+	entry->hash = 0xffff;
+}
+
+/* Caller holds en75_ppe_lock. */
+static void __en75_foe_entry_commit(struct en75_ppe *ppe,
+				    struct en75_foe_entry *entry, u16 hash)
+{
+	struct en75_foe_entry *hwe = en75_foe_get_entry(ppe, hash);
+
+	entry->ib1 &= ~EN75_FOE_IB1_BIND_TIMESTAMP;
+	entry->ib1 |= FIELD_PREP(EN75_FOE_IB1_BIND_TIMESTAMP,
+				 en75_ppe_timestamp(ppe));
+
+	/* ib1 carries the state, so it goes last and only once the rest of
+	 * the entry is visible to the engine. */
+	memcpy(&hwe->data, &entry->data, sizeof(hwe->data));
+	wmb();
+	hwe->ib1 = entry->ib1;
+	dma_wmb();
+
+	en75_ppe_cache_clear(ppe);
+}
+
+static void en75_foe_entry_clear(struct en75_ppe *ppe,
+				 struct en75_flow_entry *entry)
+{
+	spin_lock_bh(&en75_ppe_lock);
+	__en75_foe_entry_clear(ppe, entry);
+	hlist_del_init(&entry->list);
+	spin_unlock_bh(&en75_ppe_lock);
+}
+
+/*
+ * Park the entry in its bucket. Nothing is written to hardware yet --
+ * that happens in en75_ppe_check_skb() once the engine asks for it.
+ */
+static int en75_foe_entry_commit(struct en75_ppe *ppe,
+				 struct en75_flow_entry *entry)
+{
+	u32 hash = en75_ppe_hash_entry(&entry->data);
+
+	entry->hash = 0xffff;
+	spin_lock_bh(&en75_ppe_lock);
+	hlist_add_head(&entry->list,
+		       &ppe->foe_flow[hash / EN75_PPE_HASH_OFFSET]);
+	spin_unlock_bh(&en75_ppe_lock);
+
+	return 0;
+}
+
+void en75_ppe_check_skb(struct en75_ppe *ppe, struct sk_buff *skb,
+			u16 hash, u8 crsn)
+{
+	struct hlist_head *head;
+	struct en75_foe_entry *hwe;
+	struct en75_flow_entry *entry;
+	struct en75_foe_entry foe = {};
+	struct hlist_node *n;
+	int entry_len;
+
+	if (!ppe || crsn != EN75_PPE_CPU_REASON_HIT_UNBIND_RATE_REACHED)
+		return;
+
+	if (WARN_ON_ONCE(hash >= EN75_PPE_ENTRIES))
+		return;
+
+	head = &ppe->foe_flow[hash / EN75_PPE_HASH_OFFSET];
+	hwe = en75_foe_get_entry(ppe, hash);
+
+	spin_lock_bh(&en75_ppe_lock);
+
+	if (FIELD_GET(EN75_FOE_IB1_STATE, hwe->ib1) == EN75_FOE_STATE_BIND)
+		goto out;
+
+	entry_len = en75_flow_entry_match_len(hwe);
+	memcpy(&foe, hwe, entry_len);
+
+	hlist_for_each_entry_safe(entry, n, head, list) {
+		if (!en75_flow_entry_match(entry, &foe, entry_len))
+			continue;
+
+		entry->hash = hash;
+		__en75_foe_entry_commit(ppe, &entry->data, hash);
+		break;
+	}
+
+out:
+	spin_unlock_bh(&en75_ppe_lock);
+}
+
+/* ---- flow_cls offload ---- */
+
+struct en75_flow_data {
+	struct ethhdr eth;
+
+	union {
+		struct {
+			__be32 src_addr;
+			__be32 dst_addr;
+		} v4;
+
+		struct {
+			struct in6_addr src_addr;
+			struct in6_addr dst_addr;
+		} v6;
+	};
+
+	__be16 src_port;
+	__be16 dst_port;
+
+	struct {
+		struct {
+			u16 id;
+			__be16 proto;
+		} vlans[2];
+		u8 num;
+	} vlan;
+	struct {
+		u16 sid;
+		u8 num;
+	} pppoe;
+};
+
+static void en75_flow_offload_mangle_eth(const struct flow_action_entry *act,
+					 void *eth)
+{
+	void *dest = eth + act->mangle.offset;
+	const void *src = &act->mangle.val;
+
+	if (act->mangle.offset > 8)
+		return;
+
+	if (act->mangle.mask == 0xffff) {
+		src += 2;
+		dest += 2;
+	}
+
+	memcpy(dest, src, act->mangle.mask ? 2 : 4);
+}
+
+static int en75_flow_mangle_ports(const struct flow_action_entry *act,
+				  struct en75_flow_data *data)
+{
+	u32 val = ntohl(act->mangle.val);
+
+	switch (act->mangle.offset) {
+	case 0:
+		if (act->mangle.mask == ~htonl(0xffff))
+			data->dst_port = cpu_to_be16(val);
+		else
+			data->src_port = cpu_to_be16(val >> 16);
+		break;
+	case 2:
+		data->dst_port = cpu_to_be16(val);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int en75_flow_mangle_ipv4(const struct flow_action_entry *act,
+				 struct en75_flow_data *data)
+{
+	__be32 *dest;
+
+	switch (act->mangle.offset) {
+	case offsetof(struct iphdr, saddr):
+		dest = &data->v4.src_addr;
+		break;
+	case offsetof(struct iphdr, daddr):
+		dest = &data->v4.dst_addr;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	memcpy(dest, &act->mangle.val, sizeof(u32));
+
+	return 0;
+}
+
+/*
+ * If *dev is a DSA user port, substitute it with its conduit and return
+ * the port index. Only the native MTK tag is handled: the FOE entry
+ * encodes the tag itself, so a tagger with a different on-wire layout
+ * would silently produce wrong frames.
+ */
+static int en75_flow_get_dsa_port(struct net_device **dev)
+{
+#if IS_ENABLED(CONFIG_NET_DSA)
+	struct dsa_port *dp;
+
+	dp = dsa_port_from_netdev(*dev);
+	if (IS_ERR(dp))
+		return -ENODEV;
+
+	if (dp->cpu_dp->tag_ops->proto != DSA_TAG_PROTO_MTK)
+		return -ENODEV;
+
+	*dev = dsa_port_to_conduit(dp);
+
+	return dp->index;
+#else
+	return -ENODEV;
+#endif
+}
+
+static int en75_flow_set_output_device(struct en75_ppe *ppe,
+				       struct en75_foe_entry *foe,
+				       struct net_device *dev)
+{
+	int dsa_port, fport;
+
+	if (!dev)
+		return -ENODEV;
+
+	dsa_port = en75_flow_get_dsa_port(&dev);
+
+	/* After the substitution above, dev must be one of our GDM ports:
+	 * the engine can only emit through a GDM, never through a DSA user
+	 * port directly. */
+	fport = en75_port_fport(dev);
+	if (fport != ETX_FPORT_GDM1 && fport != ETX_FPORT_GDM2)
+		return -EOPNOTSUPP;
+
+	if (dsa_port >= 0)
+		en75_foe_entry_set_dsa(foe, dsa_port);
+
+	en75_foe_entry_set_pse_port(foe, fport);
+
+	return 0;
+}
+
+static int en75_flow_offload_replace(struct en75_ppe *ppe,
+				     struct flow_cls_offload *f)
+{
+	struct flow_rule *rule = flow_cls_offload_flow_rule(f);
+	struct net_device *odev = NULL;
+	struct flow_action_entry *act;
+	struct en75_flow_data data = {};
+	struct en75_foe_entry foe;
+	struct en75_flow_entry *entry;
+	int offload_type = 0;
+	u16 addr_type = 0;
+	u8 l4proto = 0;
+	int err = 0;
+	int i;
+
+	if (rhashtable_lookup_fast(&ppe->flow_table, &f->cookie,
+				   en75_flow_ht_params))
+		return -EEXIST;
+
+	if (!flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_META))
+		return -EOPNOTSUPP;
+
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CONTROL)) {
+		struct flow_match_control match;
+
+		flow_rule_match_control(rule, &match);
+		addr_type = match.key->addr_type;
+
+		if (flow_rule_has_control_flags(match.mask->flags,
+						f->common.extack))
+			return -EOPNOTSUPP;
+	} else {
+		return -EOPNOTSUPP;
+	}
+
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_BASIC)) {
+		struct flow_match_basic match;
+
+		flow_rule_match_basic(rule, &match);
+		l4proto = match.key->ip_proto;
+	} else {
+		return -EOPNOTSUPP;
+	}
+
+	switch (addr_type) {
+	case FLOW_DISSECTOR_KEY_IPV4_ADDRS:
+		offload_type = EN75_PPE_PKT_TYPE_IPV4_HNAPT;
+		break;
+	case FLOW_DISSECTOR_KEY_IPV6_ADDRS:
+		offload_type = EN75_PPE_PKT_TYPE_IPV6_ROUTE_5T;
+		break;
+	default:
+		/* addr_type 0 is a bridged flow, which needs the L2 subflow
+		 * machinery this port leaves out. */
+		return -EOPNOTSUPP;
+	}
+
+	flow_action_for_each(i, act, &rule->action) {
+		switch (act->id) {
+		case FLOW_ACTION_MANGLE:
+			if (act->mangle.htype == FLOW_ACT_MANGLE_HDR_TYPE_ETH)
+				en75_flow_offload_mangle_eth(act, &data.eth);
+			break;
+		case FLOW_ACTION_REDIRECT:
+			odev = act->dev;
+			break;
+		case FLOW_ACTION_CSUM:
+			break;
+		case FLOW_ACTION_VLAN_PUSH:
+			if (data.vlan.num + data.pppoe.num == 2 ||
+			    act->vlan.proto != htons(ETH_P_8021Q))
+				return -EOPNOTSUPP;
+
+			data.vlan.vlans[data.vlan.num].id = act->vlan.vid;
+			data.vlan.vlans[data.vlan.num].proto = act->vlan.proto;
+			data.vlan.num++;
+			break;
+		case FLOW_ACTION_VLAN_POP:
+			break;
+		case FLOW_ACTION_PPPOE_PUSH:
+			if (data.pppoe.num == 1 || data.vlan.num == 2)
+				return -EOPNOTSUPP;
+
+			data.pppoe.sid = act->pppoe.sid;
+			data.pppoe.num++;
+			break;
+		default:
+			return -EOPNOTSUPP;
+		}
+	}
+
+	if (!is_valid_ether_addr(data.eth.h_source) ||
+	    !is_valid_ether_addr(data.eth.h_dest))
+		return -EINVAL;
+
+	err = en75_foe_entry_prepare(&foe, offload_type, l4proto, 0,
+				     data.eth.h_source, data.eth.h_dest);
+	if (err)
+		return err;
+
+	if (!flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS))
+		return -EOPNOTSUPP;
+
+	{
+		struct flow_match_ports ports;
+
+		flow_rule_match_ports(rule, &ports);
+		data.src_port = ports.key->src;
+		data.dst_port = ports.key->dst;
+	}
+
+	if (addr_type == FLOW_DISSECTOR_KEY_IPV4_ADDRS) {
+		struct flow_match_ipv4_addrs addrs;
+
+		flow_rule_match_ipv4_addrs(rule, &addrs);
+
+		data.v4.src_addr = addrs.key->src;
+		data.v4.dst_addr = addrs.key->dst;
+
+		en75_foe_entry_set_ipv4_tuple(&foe, false, data.v4.src_addr,
+					      data.src_port, data.v4.dst_addr,
+					      data.dst_port);
+	} else {
+		struct flow_match_ipv6_addrs addrs;
+
+		flow_rule_match_ipv6_addrs(rule, &addrs);
+
+		data.v6.src_addr = addrs.key->src;
+		data.v6.dst_addr = addrs.key->dst;
+
+		en75_foe_entry_set_ipv6_tuple(&foe, data.v6.src_addr.s6_addr32,
+					      data.src_port,
+					      data.v6.dst_addr.s6_addr32,
+					      data.dst_port);
+	}
+
+	/* The NAT rewrite: a second pass over the actions, now that the
+	 * original tuple is in place, fills in the translated one. */
+	flow_action_for_each(i, act, &rule->action) {
+		if (act->id != FLOW_ACTION_MANGLE)
+			continue;
+
+		switch (act->mangle.htype) {
+		case FLOW_ACT_MANGLE_HDR_TYPE_TCP:
+		case FLOW_ACT_MANGLE_HDR_TYPE_UDP:
+			err = en75_flow_mangle_ports(act, &data);
+			break;
+		case FLOW_ACT_MANGLE_HDR_TYPE_IP4:
+			err = en75_flow_mangle_ipv4(act, &data);
+			break;
+		case FLOW_ACT_MANGLE_HDR_TYPE_ETH:
+			/* handled in the first pass */
+			break;
+		default:
+			return -EOPNOTSUPP;
+		}
+
+		if (err)
+			return err;
+	}
+
+	if (addr_type == FLOW_DISSECTOR_KEY_IPV4_ADDRS) {
+		err = en75_foe_entry_set_ipv4_tuple(&foe, true,
+						    data.v4.src_addr,
+						    data.src_port,
+						    data.v4.dst_addr,
+						    data.dst_port);
+		if (err)
+			return err;
+	}
+
+	err = en75_flow_set_output_device(ppe, &foe, odev);
+	if (err)
+		return err;
+
+	for (i = 0; i < data.vlan.num; i++) {
+		err = en75_foe_entry_set_vlan(&foe, data.vlan.vlans[i].id);
+		if (err)
+			return err;
+	}
+
+	if (data.pppoe.num == 1) {
+		err = en75_foe_entry_set_pppoe(&foe, data.pppoe.sid);
+		if (err)
+			return err;
+	}
+
+	entry = kzalloc(sizeof(*entry), GFP_KERNEL);
+	if (!entry)
+		return -ENOMEM;
+
+	entry->cookie = f->cookie;
+	memcpy(&entry->data, &foe, sizeof(entry->data));
+
+	err = en75_foe_entry_commit(ppe, entry);
+	if (err < 0)
+		goto free;
+
+	err = rhashtable_insert_fast(&ppe->flow_table, &entry->node,
+				     en75_flow_ht_params);
+	if (err < 0)
+		goto clear;
+
+	return 0;
+
+clear:
+	en75_foe_entry_clear(ppe, entry);
+free:
+	kfree(entry);
+	return err;
+}
+
+static int en75_flow_offload_destroy(struct en75_ppe *ppe,
+				     struct flow_cls_offload *f)
+{
+	struct en75_flow_entry *entry;
+
+	entry = rhashtable_lookup_fast(&ppe->flow_table, &f->cookie,
+				       en75_flow_ht_params);
+	if (!entry)
+		return -ENOENT;
+
+	en75_foe_entry_clear(ppe, entry);
+	rhashtable_remove_fast(&ppe->flow_table, &entry->node,
+			       en75_flow_ht_params);
+	kfree(entry);
+
+	return 0;
+}
+
+static int en75_flow_offload_cmd(struct en75_ppe *ppe,
+				 struct flow_cls_offload *cls)
+{
+	int err;
+
+	mutex_lock(&en75_ppe_mutex);
+	switch (cls->command) {
+	case FLOW_CLS_REPLACE:
+		err = en75_flow_offload_replace(ppe, cls);
+		break;
+	case FLOW_CLS_DESTROY:
+		err = en75_flow_offload_destroy(ppe, cls);
+		break;
+	default:
+		/* No FLOW_CLS_STATS: this PPE revision's per-entry MIB
+		 * counters have not been located, so reporting zero would
+		 * make the flowtable age every offloaded flow out. */
+		err = -EOPNOTSUPP;
+		break;
+	}
+	mutex_unlock(&en75_ppe_mutex);
+
+	return err;
+}
+
+static int en75_setup_tc_block_cb(enum tc_setup_type type, void *type_data,
+				  void *cb_priv)
+{
+	struct en75_ppe *ppe = cb_priv;
+
+	if (type != TC_SETUP_CLSFLOWER)
+		return -EOPNOTSUPP;
+
+	return en75_flow_offload_cmd(ppe, type_data);
+}
+
+static int en75_setup_tc_block(struct en75_ppe *ppe, struct net_device *dev,
+			       struct flow_block_offload *f)
+{
+	static LIST_HEAD(block_cb_list);
+	struct flow_block_cb *block_cb;
+	flow_setup_cb_t *cb = en75_setup_tc_block_cb;
+
+	if (f->binder_type != FLOW_BLOCK_BINDER_TYPE_CLSACT_INGRESS)
+		return -EOPNOTSUPP;
+
+	f->driver_block_list = &block_cb_list;
+
+	switch (f->command) {
+	case FLOW_BLOCK_BIND:
+		block_cb = flow_block_cb_lookup(f->block, cb, ppe);
+		if (block_cb) {
+			flow_block_cb_incref(block_cb);
+			return 0;
+		}
+		block_cb = flow_block_cb_alloc(cb, ppe, ppe, NULL);
+		if (IS_ERR(block_cb))
+			return PTR_ERR(block_cb);
+
+		flow_block_cb_incref(block_cb);
+		flow_block_cb_add(block_cb, f);
+		list_add_tail(&block_cb->driver_list, &block_cb_list);
+		return 0;
+	case FLOW_BLOCK_UNBIND:
+		block_cb = flow_block_cb_lookup(f->block, cb, ppe);
+		if (!block_cb)
+			return -ENOENT;
+
+		if (!flow_block_cb_decref(block_cb)) {
+			flow_block_cb_remove(block_cb, f);
+			list_del(&block_cb->driver_list);
+		}
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+int en75_ppe_setup_tc(struct en75_ppe *ppe, struct net_device *dev,
+		      enum tc_setup_type type, void *type_data)
+{
+	if (!ppe)
+		return -EOPNOTSUPP;
+
+	switch (type) {
+	case TC_SETUP_BLOCK:
+	case TC_SETUP_FT:
+		return en75_setup_tc_block(ppe, dev, type_data);
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+/* ---- setup / teardown ---- */
+
+int en75_ppe_flows_show(struct seq_file *m, void *v)
+{
+	struct en75_ppe *ppe = m->private;
+	int i, bound = 0, pending = 0;
+
+	if (!ppe) {
+		seq_puts(m, "PPE flow offload not initialised\n");
+		return 0;
+	}
+
+	spin_lock_bh(&en75_ppe_lock);
+	for (i = 0; i < ARRAY_SIZE(ppe->foe_flow); i++) {
+		struct en75_flow_entry *entry;
+
+		hlist_for_each_entry(entry, &ppe->foe_flow[i], list) {
+			if (entry->hash == 0xffff)
+				pending++;
+			else
+				bound++;
+		}
+	}
+	spin_unlock_bh(&en75_ppe_lock);
+
+	seq_printf(m, "flows pending = %d\n", pending);
+	seq_printf(m, "flows bound   = %d\n", bound);
+	seq_printf(m, "foe entries   = %u / %u\n",
+		   ppe_r32(ppe, PPE_TB_USED), EN75_PPE_ENTRIES);
+
+	return 0;
+}
+
+struct en75_ppe *en75_ppe_flow_init(struct device *dev, void __iomem *fe_base,
+				    void __iomem *ppe_base,
+				    struct en75_foe_entry *foe_table)
+{
+	struct en75_ppe *ppe;
+	int err;
+
+	BUILD_BUG_ON(sizeof(struct en75_foe_entry) != EN75_PPE_ENTRY_SIZE);
+
+	/* Dominated by ~32 KiB of hlist heads, one per hash bucket. */
+	ppe = devm_kzalloc(dev, sizeof(*ppe), GFP_KERNEL);
+	if (!ppe)
+		return ERR_PTR(-ENOMEM);
+
+	ppe->dev = dev;
+	ppe->fe_base = fe_base;
+	ppe->base = ppe_base;
+	ppe->foe_table = foe_table;
+
+	err = rhashtable_init(&ppe->flow_table, &en75_flow_ht_params);
+	if (err)
+		return ERR_PTR(err);
+
+	ppe->flow_table_ready = true;
+
+	return ppe;
+}
+
+static void en75_ppe_free_flow(void *ptr, void *arg)
+{
+	kfree(ptr);
+}
+
+void en75_ppe_flow_exit(struct en75_ppe *ppe)
+{
+	if (!ppe || !ppe->flow_table_ready)
+		return;
+
+	rhashtable_free_and_destroy(&ppe->flow_table, en75_ppe_free_flow, NULL);
+	ppe->flow_table_ready = false;
+}
