+	if (port_id >= ARRAY_SIZE(port->dsa_meta) || !port->dsa_meta[port_id])
+		return NULL;
+
+	return &port->dsa_meta[port_id]->dst;
+}
+
+void en75_port_free_metadata(struct net_device *dev)
+{
+	en75_metadata_dst_free(netdev_priv(dev));
