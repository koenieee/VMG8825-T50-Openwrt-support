. /lib/functions.sh

[ "$ACTION" = "add" ] || exit 0
[ "$(board_name)" = "zyxel,vmg8825-t50" ] || exit 0

# This runs from the ieee80211 hotplug hook rather than from uci-defaults,
# and the ordering is the whole reason. /etc/config/wireless does not exist
# when uci-defaults runs -- it is written by 10-wifi-detect in this very
# directory, once the phys actually appear -- so a uci-defaults script finds
# no wifi-device sections to walk and silently does nothing. Running at 20
# puts us just after the detection that creates them.
#
# Once is enough. Leaving a stamp behind means a later `wifi config`, or the
# user's own choice of band, is not quietly overwritten on the next boot.
STAMP=/etc/vmg8825-t50-band-split.done
[ -f "$STAMP" ] && exit 0

# Two onboard MT7615 cards, each capable of either band, so OpenWrt's
# auto-detect puts both on 5GHz -- two overlapping 5GHz APs and no 2.4GHz
# coverage at all. They have to be split, and it matters a great deal
# which card gets which band.
#
# The cards are not interchangeable. Their calibration data differs (see
# the "wifi-caldata" nvmem cells in the dts):
#
#   1fb81000.pcie  NIC_CONF_1 TSSI bits set, 2.4GHz target power 0x22
#                  (17dBm) in the TSSI table at 0x058.
#   1fb83000.pcie  TSSI bits clear, so mt7615 takes target power from the
#                  external-PA bytes at 0xf2/0xf3 instead -- and the
#                  2.4GHz one, 0xf2, is zero. 5GHz (0xf3) is 0x26, 19dBm.
#
# Put 2.4GHz on the card with no 2.4GHz calibration and mt7615_init_txpower
# caps the channel at 10dBm. Measured on hardware, both ways round:
#
#   1fb81000=5g, 1fb83000=2g   ->  18dBm / 10dBm
#   1fb81000=2g, 1fb83000=5g   ->  20dBm / 20dBm   (regulatory ceiling)
#
# So bind by PCIe path, not by radio index, which is only as stable as
# probe order.
#
# Channel and htmode have to move with the band: auto-detect stamps every
# radio with channel 36 / VHT80, which are 5GHz-only values that leave
# hostapd on a degraded fallback config on 2.4GHz (and VHT is not valid
# there for this chip anyway -- iwinfo reports phy 802.11n/g/b, no ac).
set_band() {
	local dev="$1" path band channel htmode

	path="$(uci -q get wireless.$dev.path)"
	case "$path" in
	*1fb81000.pcie*) band=2g; channel=auto; htmode=HT20 ;;
	*1fb83000.pcie*) band=5g; channel=36;   htmode=VHT80 ;;
	*) return 0 ;;
	esac

	uci set wireless.$dev.band="$band"
	uci set wireless.$dev.channel="$channel"
	uci set wireless.$dev.htmode="$htmode"
}

# Both APs on. Auto-detect leaves them disabled, which on a router whose
# only other way in is a serial cable is not a helpful default.
enable_iface() {
	uci set wireless.$1.disabled='0'
}

config_load wireless
config_foreach set_band wifi-device
config_foreach enable_iface wifi-iface

# Nothing to stamp if detection has not produced any radios yet; we will be
# called again for the next phy.
uci -q get wireless.radio0.path >/dev/null || exit 0

uci commit wireless

# Stamp before reloading, not after: `wifi reload` brings the phys back and
# so re-enters this hook, and the stamp is what stops that from looping.
touch "$STAMP"

# The radios were already started from the config detection wrote, so the
# band we just corrected only takes effect on a reload. Detached, because a
# hotplug handler that waits for the interface it is restarting deadlocks.
(/sbin/wifi reload) >/dev/null 2>&1 &

exit 0
