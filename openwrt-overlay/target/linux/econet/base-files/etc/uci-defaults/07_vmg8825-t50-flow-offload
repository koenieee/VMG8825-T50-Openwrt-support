#!/bin/sh
#
# Turn flow offloading on out of the box. The PPE forwards at 937 Mbit/s
# with the CPU 99.9% idle; the software path on the same board manages
# about 300 Mbit/s and spends 40% of a core doing it. There is no reason
# to make people find this setting themselves.
#
. /lib/functions.sh

[ "$(board_name)" = "zyxel,vmg8825-t50" ] || exit 0

uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set firewall.@defaults[0].flow_offloading_hw='1'
uci commit firewall

exit 0
