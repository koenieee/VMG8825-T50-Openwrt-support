/dts-v1/;

#include <dt-bindings/interrupt-controller/mips-gic.h>
#include <dt-bindings/clock/en7523-clk.h>
#include <dt-bindings/reset/airoha,en7523-reset.h>

/ {
	compatible = "econet,en751627";
	#address-cells = <1>;
	#size-cells = <1>;

	hpt_clock: clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000000>;  /* 200 MHz */
	};

	spi_clock: spi-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <40000000>;  /* 40 MHz */
	};

	/*
	 * USB PHY reference crystal. EcoNet devices run at either 20MHz or
	 * 25MHz (per econet,en751221-usb-phy binding); this board's actual
	 * xtal frequency has not been confirmed against real hardware, and
	 * 20MHz is assumed as the more common default. A wrong guess only
	 * affects the USB 3.0 PLL tuning path, not USB 2.0.
	 */
	usb_xtal: usb-xtal-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <20000000>;  /* 20 MHz, unconfirmed */
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "mips,mips1004Kc";
			reg = <0>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "mips,mips1004Kc";
			reg = <1>;
		};
	};

	cpuintc: interrupt-controller {
		compatible = "mti,cpu-interrupt-controller";
		interrupt-controller;
		#address-cells = <0>;
		#interrupt-cells = <1>;
	};

	gic: interrupt-controller@1f8c0000 {
		compatible = "mti,gic";
		reg = <0x1f8c0000 0x20000>;

		interrupt-controller;
		#interrupt-cells = <3>;

		interrupt-parent = <&cpuintc>;
		interrupts = <2>;
	};

	pcie_phy0: pcie-phy@1faf2000 {
		compatible = "econet,en7528-pcie-gen2";
		reg = <0x1faf2000 0x1000>;
		#phy-cells = <0>;
	};

	pcie_phy1: pcie-phy@1fac0000 {
		compatible = "econet,en7528-pcie-gen2";
		reg = <0x1fac0000 0x1000>;
		#phy-cells = <0>;
	};

	gpio0: gpio@1fbf0200 {
		compatible = "airoha,en7523-gpio";
		reg = <0x1fbf0204 0x4>,
		      <0x1fbf0200 0x4>,
		      <0x1fbf0220 0x4>,
		      <0x1fbf0214 0x4>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	gpio1: gpio@1fbf0270 {
		compatible = "airoha,en7523-gpio";
		reg = <0x1fbf0270 0x4>,
		      <0x1fbf0260 0x4>,
		      <0x1fbf0264 0x4>,
		      <0x1fbf0278 0x4>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	scu: system-controller@1fb00000 {
		compatible = "airoha,en7523-scu";
		reg = <0x1fa20000 0x400>,
		      <0x1fb00000 0x1000>;
		#clock-cells = <1>;
		#reset-cells = <1>;
	};

	timer_hpt: timer@1fbf0400 {
		compatible = "econet,en7528-timer";
		reg = <0x1fbf0400 0x14>,
		      <0x1fbe0000 0x14>;

		interrupt-parent = <&gic>;
		interrupts = <GIC_SHARED 30 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SHARED 29 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SHARED 37 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SHARED 36 IRQ_TYPE_LEVEL_HIGH>;

		clocks = <&hpt_clock>;
	};

	spi_ctrl: spi@1fa10000 {
		compatible = "airoha,en7581-snand";
		reg = <0x1fa10000 0x140>,
		      <0x1fa11000 0x160>;

		clocks = <&spi_clock>;
		clock-names = "spi";

		#address-cells = <1>;
		#size-cells = <0>;

		nand: nand@0 {
			compatible = "spi-nand";
			reg = <0>;
			spi-max-frequency = <40000000>;
			spi-tx-bus-width = <1>;
			spi-rx-bus-width = <2>;
		};
	};

	uart: serial@1fbf0000 {
		compatible = "airoha,en7523-uart";
		reg = <0x1fbf0000 0x30>;
		reg-io-width = <4>;
		reg-shift = <2>;

		interrupt-parent = <&gic>;
		interrupts = <GIC_SHARED 2 IRQ_TYPE_LEVEL_HIGH>;

		clock-frequency = <7372800>;
	};

	pciecfg: pciecfg@1fb80000 {
		compatible = "mediatek,generic-pciecfg", "syscon";
		reg = <0x1fb80000 0x1000>;
	};

	pcie0: pcie@1fb81000 {
		compatible = "econet,en7528-pcie";
		device_type = "pci";
		reg = <0x1fb81000 0x1000>;
		reg-names = "port0";
		linux,pci-domain = <0>;
		#address-cells = <3>;
		#size-cells = <2>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SHARED 23 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "pcie_irq";
		clocks = <&scu EN7523_CLK_PCIE>;
		clock-names = "sys_ck0";
		phys = <&pcie_phy0>;
		phy-names = "pcie-phy0";
		bus-range = <0x00 0xff>;
		ranges = <0x01000000 0 0x00000000 0x1f600000 0 0x00010000>,
			 <0x82000000 0 0x20000000 0x20000000 0 0x08000000>;
		status = "disabled";

		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &pcie_intc0 0>,
				<0 0 0 2 &pcie_intc0 1>,
				<0 0 0 3 &pcie_intc0 2>,
				<0 0 0 4 &pcie_intc0 3>;

		pcie_intc0: interrupt-controller {
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <1>;
		};

		slot0: pcie@0,0 {
			reg = <0x0000 0 0 0 0>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges;
		};
	};

	pcie1: pcie@1fb83000 {
		compatible = "econet,en7528-pcie";
		device_type = "pci";
		reg = <0x1fb83000 0x1000>;
		reg-names = "port1";
		linux,pci-domain = <1>;
		#address-cells = <3>;
		#size-cells = <2>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SHARED 24 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "pcie_irq";
		clocks = <&scu EN7523_CLK_PCIE>;
		clock-names = "sys_ck1";
		phys = <&pcie_phy1>;
		phy-names = "pcie-phy1";
		bus-range = <0x00 0xff>;
		ranges = <0x01000000 0 0x00000000 0x1f610000 0 0x00010000>,
			 <0x82000000 0 0x28000000 0x28000000 0 0x08000000>;
		status = "disabled";

		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &pcie_intc1 0>,
				<0 0 0 2 &pcie_intc1 1>,
				<0 0 0 3 &pcie_intc1 2>,
				<0 0 0 4 &pcie_intc1 3>;

		pcie_intc1: interrupt-controller {
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <1>;
		};

		slot1: pcie@1,0 {
			reg = <0x0800 0 0 0 0>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges;
		};
	};

	/*
	 * USB PHY (SIFSLV SPLLC/FMREG @0x1fa80000, single-port QFP wiring:
	 * U2PHY_COM @0x1fa80800, U3PHYD/A @0x1fa80900). Based on upstream
	 * "phy: econet: Add EcoNet USB PHY" (Caleb James DeLisle,
	 * cjd@cjdns.fr, msgid 20260518141343.401555-3-cjd@cjdns.fr),
	 * not yet merged upstream at the time this was written.
	 */
	usb_phy: usb-phy@1fa80000 {
		compatible = "econet,en751627-usb-phy";
		reg = <0x1fa80000 0x700>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		clocks = <&usb_xtal>;
		clock-names = "xtal";

		usb2_phy_p0: usb-phy@1fa80800 {
			compatible = "econet,usb2-phy";
			reg = <0x1fa80800 0x100>;
			resets = <&scu EN7523_USB_HOST_P0_RST>;
			econet,usb-port-id = <0>;
			#phy-cells = <0>;
		};

		usb3_phy_p0: usb-phy@1fa80900 {
			compatible = "econet,usb3-phy";
			reg = <0x1fa80900 0x700>;
			resets = <&scu EN7523_USB_HOST_P0_RST>;
			econet,usb-port-id = <0>;
			#phy-cells = <0>;
		};
	};

	usb: usb@1fb90000 {
		compatible = "mediatek,mt8173-xhci", "mediatek,mtk-xhci";
		reg = <0x1fb90000 0x4000>,
			<0x1fa80700 0x100>;
		reg-names = "mac", "ippc";

		#address-cells = <1>;
		#size-cells = <0>;

		interrupt-parent = <&gic>;
		interrupts = <GIC_SHARED 17 IRQ_TYPE_LEVEL_HIGH>;
		phys = <&usb2_phy_p0>, <&usb3_phy_p0>;
		usb3-lpm-capable;
		/*
		 * The SuperSpeed (U3) MAC reset-inactive status bit never
		 * comes up on this board (STS1_U3_MAC_RST stuck low while
		 * every USB 2.0 clock bit is stable), consistent with only
		 * a USB 2.0 port being physically wired. Mask off U3 port 0
		 * so xhci-mtk's clock-stable poll doesn't wait on it.
		 */
		mediatek,u3p-dis-msk = <0x1>;
	};

	/*
	 * FE/GDM/QDMA block (econet-eth out-of-tree driver, cjdelisle/econet_eth,
	 * package/kernel/econet-eth patches/001-add-en751627-support.patch).
	 * reg is sized 0x8000 (en7528-style): the driver derives has_switch_regs
	 * from resource_size(reg) >= sizeof(struct en751221_regs) (0x10000), so
	 * this automatically skips its own PMCR/MFC switch pokes -- the switch
	 * register space now belongs to the separate DSA `switch` node below.
	 *
	 * gmac0 feeds the on-die MT7530-class switch's CPU port (port 6, see
	 * `switch` node) over an internal MAC-to-MAC link. gmac1 is the discrete
	 * ETHWAN MAC, talking to a standalone external PHY outside the switch.
	 */
	ethernet: ethernet@1fb50000 {
		compatible = "econet,en751627-eth";
		reg = <0x1fb50000 0x8000>;

		#address-cells = <1>;
		#size-cells = <0>;

		interrupt-parent = <&gic>;
		interrupts = <GIC_SHARED 21 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SHARED 22 IRQ_TYPE_LEVEL_HIGH>;

		resets = <&scu EN7523_FE_RST>,
			 <&scu EN7523_FE_PDMA_RST>,
			 <&scu EN7523_FE_QDMA_RST>;
		reset-names = "fe", "qdma0", "qdma1";

		gmac0: mac@0 {
			compatible = "econet,eth-mac";
			reg = <0>;
			phy-mode = "internal";
			status = "disabled";

			fixed-link {
				speed = <1000>;
				full-duplex;
				pause;
			};
		};

		gmac1: mac@1 {
			compatible = "econet,eth-mac";
			reg = <1>;
			phy-mode = "rgmii-rxid";
			status = "disabled";
		};
	};

	/*
	 * On-die MT7530-class DSA switch. Confirmed live on a VMG8825-T50:
	 * the CREV register (switch base + 0x7ffc) reads 0x75300000 -- top
	 * 16 bits 0x7530, same core and same base address as en7528.dtsi's
	 * `switch` node. See target/linux/econet/patches-6.18/782-net-dsa-
	 * mt7530-add-en751627-support.patch for the driver-side ID.
	 *
	 * Replaces the old econet-eth-driven PHY_IAC bit-bang bring-up
	 * (package/kernel/econet-eth patches/002-mt7530-embedded-phy-init.patch)
	 * with the same in-tree DSA driver every other MT7530-class board
	 * (including EN7528, next door) uses -- real phylink-managed PHYs
	 * instead of a hardware-forced CPU port link.
	 */
	switch: ethernet-switch@1fb58000 {
		compatible = "econet,en751627-switch";
		reg = <0x1fb58000 0x8000>;
		resets = <&scu EN7523_GSW_RST>;

		status = "disabled";

		#address-cells = <1>;
		#size-cells = <0>;

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			gsw_port1: ethernet-port@1 {
				reg = <1>;
				phy-mode = "internal";
				phy-handle = <&gsw_phy1>;
				status = "disabled";
			};

			gsw_port2: ethernet-port@2 {
				reg = <2>;
				phy-mode = "internal";
				phy-handle = <&gsw_phy2>;
				status = "disabled";
			};

			gsw_port3: ethernet-port@3 {
				reg = <3>;
				phy-mode = "internal";
				phy-handle = <&gsw_phy3>;
				status = "disabled";
			};

			gsw_port4: ethernet-port@4 {
				reg = <4>;
				phy-mode = "internal";
				phy-handle = <&gsw_phy4>;
				status = "disabled";
			};

			ethernet-port@6 {
				reg = <6>;
				ethernet = <&gmac0>;
				phy-mode = "internal";

				fixed-link {
					speed = <1000>;
					full-duplex;
					pause;
				};
			};
		};

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			gsw_phy1: ethernet-phy@9 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <9>;
			};

			gsw_phy2: ethernet-phy@a {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <10>;
			};

			gsw_phy3: ethernet-phy@b {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <11>;
			};

			gsw_phy4: ethernet-phy@c {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <12>;
			};
		};
	};
};
